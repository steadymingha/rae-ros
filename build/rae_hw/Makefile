	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_speed.dir/build.make CMakeFiles/test_speed.dir/test/test_speed.cpp.i
.PHONY : test/test_speed.cpp.i

test/test_speed.s: test/test_speed.cpp.s
.PHONY : test/test_speed.s

# target to generate assembly for a file
test/test_speed.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_speed.dir/build.make CMakeFiles/test_speed.dir/test/test_speed.cpp.s
.PHONY : test/test_speed.cpp.s

